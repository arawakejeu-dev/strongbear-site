# Search Console can be enabled independently without client-side JavaScript.
NEXT_PUBLIC_SITE_URL=https://strongbearbjj.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics remain unloaded until consent and a privacy-policy URL are configured.
# Prefer GTM for a single orchestration layer; GA4 direct loading is the fallback.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_LEGAL_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_NEWSLETTER_URL=

# External booking destination.
NEXT_PUBLIC_FIGHTY_URL=https://fighty.com/p/strongbear
