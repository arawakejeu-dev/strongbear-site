{
  "name": "strongbear-home",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "next build --webpack",
    "build:hostinger": "STATIC_EXPORT=1 next build --webpack && node scripts/prepare-hostinger-export.mjs",
    "start": "next start",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --test tests/rendered-html.test.mjs",
    "test:hostinger": "pnpm run build && node --test tests/next-hostinger.test.mjs",
    "audit:quality": "node scripts/quality-audit.mjs",
    "audit:launch": "node scripts/launch-audit.mts",
    "media:build": "node scripts/generate-performance-assets.mts",
    "media:video": "node scripts/generate-video-assets.mts",
    "media:all": "pnpm run media:build && pnpm run media:video && pnpm run media:audit",
    "media:audit": "node scripts/audit-media.mts",
    "media:export": "node scripts/export-media-inventory.mts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
